    },
    {
     "name": "overtime_cap_hours",
     "type": "float",
     "required": true,
     "allowed": ">=0",
     "unit": "hours",
     "unique": "-",
     "fk": null,
     "rule": "employees.overtime_cap_hours"
    },
    {
     "name": "hard_limit_hours",
     "type": "float",
     "required": true,
     "allowed": ">0",
     "unit": "hours",
     "unique": "-",
     "fk": null,
     "rule": "contract_cap + overtime_cap"
    },
    {
     "name": "overtime_hours",
     "type": "float",
     "required": true,
     "allowed": ">=0",
     "unit": "hours",
     "unique": "-",
     "fk": null,
     "rule": "max(0, worked_hours - contract_cap)"
    },
    {
     "name": "scheduled_exceeds_limit",
     "type": "bool",
     "required": true,
     "allowed": "ENUM:0,1",
     "unit": "-",
     "unique": "-",
     "fk": null,
     "rule": "scheduled_hours > hard_limit_hours"
    },
    {
     "name": "worked_exceeds_limit",
     "type": "bool",
     "required": true,
     "allowed": "ENUM:0,1",
     "unit": "-",
     "unique": "-",
     "fk": null,
     "rule": "worked_hours > hard_limit_hours"
    }
   ]
  },
