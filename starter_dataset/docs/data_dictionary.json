     "unique": "-",
     "fk": null,
     "rule": "-"
    },
    {
     "name": "status",
     "type": "string",
     "required": true,
     "allowed": "ENUM:REQUESTED,APPROVED,REJECTED,CANCELLED,APPLIED",
