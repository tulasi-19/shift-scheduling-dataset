     "unique": "-",
     "fk": null,
     "rule": "equals to_status of the last swap_events row"
    },
    {
     "name": "requested_at",
     "type": "datetime",
     "required": true,
     "allowed": "ISO-8601",
     "unit": "local time",
     "unique": "-",
     "fk": null,
     "rule": "before shift start"
    },
    {
     "name": "decided_at",
     "type": "datetime",
     "required": false,
